generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum ApplicationStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum SessionStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")
}

enum TokenStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")
}

enum PolicyEffect {
  ALLOW @map("allow")
}

enum AuditResult {
  SUCCESS @map("success")
  FAILED  @map("failed")
}

enum EventStatus {
  PENDING       @map("pending")
  PUBLISHED     @map("published")
  PROCESSED     @map("processed")
  DEAD_LETTERED @map("dead_lettered")
}

enum DeliveryStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SUCCEEDED  @map("succeeded")
  RETRYING   @map("retrying")
  FAILED     @map("failed")
}

enum MfaChallengeStatus {
  PENDING @map("pending")
  USED    @map("used")
  EXPIRED @map("expired")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  groups             UserGroup[]
  ssoSessions        SsoSession[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  auditLogs          AuditLog[]          @relation("AuditTargetUser")
  events             Event[]
  mfaTotpCredential  MfaTotpCredential?
  mfaChallenges      MfaChallenge[]

  @@map("users")
}

model AccessGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users    UserGroup[]
  policies ApplicationGroupPolicy[]

  @@map("groups")
}

model UserGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("user_groups")
}

model Application {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  clientId              String            @unique @map("client_id")
  clientSecretHash      String?           @map("client_secret_hash")
  status                ApplicationStatus @default(ACTIVE)
  launchUrl             String?           @map("launch_url")
  logoutNotificationUrl String            @map("logout_notification_url")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  redirectUris       ApplicationRedirectUri[]
  policies           ApplicationGroupPolicy[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  auditLogs          AuditLog[]
  events             Event[]
  eventDeliveries    EventDelivery[]

  @@map("applications")
}

model ApplicationRedirectUri {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  redirectUri   String   @map("redirect_uri")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, redirectUri])
  @@map("application_redirect_uris")
}

model ApplicationGroupPolicy {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  groupId       String       @map("group_id") @db.Uuid
  effect        PolicyEffect @default(ALLOW)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  group       AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([applicationId, groupId, effect])
  @@map("application_group_policies")
}

model SsoSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  sessionTokenHash String        @unique @map("session_token_hash")
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  lastActivityAt   DateTime?     @map("last_activity_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?       @map("revoke_reason")
  ipAddress        String?       @map("ip_address")
  userAgent        String?       @map("user_agent")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  events             Event[]

  @@index([userId, status])
  @@map("sso_sessions")
}

model MfaTotpCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_totp_credentials")
}

model MfaChallenge {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  challengeTokenHash String             @unique @map("challenge_token_hash")
  status             MfaChallengeStatus @default(PENDING)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime           @map("expires_at") @db.Timestamptz(6)
  usedAt             DateTime?          @map("used_at") @db.Timestamptz(6)
  ipAddress          String?            @map("ip_address")
  userAgent          String?            @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("mfa_challenges")
}

model AuthorizationCode {
  id                  String    @id @default(uuid()) @db.Uuid
  codeHash            String    @unique @map("code_hash")
  userId              String    @map("user_id") @db.Uuid
  applicationId       String    @map("application_id") @db.Uuid
  ssoSessionId        String    @map("sso_session_id") @db.Uuid
  redirectUri         String    @map("redirect_uri")
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt              DateTime? @map("used_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ssoSession  SsoSession  @relation(fields: [ssoSessionId], references: [id], onDelete: Cascade)

  @@index([applicationId, expiresAt])
  @@map("authorization_codes")
}

model AccessToken {
  id            String      @id @default(uuid()) @db.Uuid
  tokenHash     String      @unique @map("token_hash")
  userId        String      @map("user_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  ssoSessionId  String      @map("sso_session_id") @db.Uuid
  scopes        Json?
  status        TokenStatus @default(ACTIVE)
  issuedAt      DateTime    @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ssoSession  SsoSession  @relation(fields: [ssoSessionId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@map("access_tokens")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  eventType     String      @map("event_type")
  actorId       String?     @map("actor_id") @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  applicationId String?     @map("application_id") @db.Uuid
  sessionId     String?     @map("session_id") @db.Uuid
  result        AuditResult
  metadata      Json?
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User?        @relation("AuditTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@map("audit_logs")
}

model Event {
  id               String      @id @default(uuid()) @db.Uuid
  eventType        String      @map("event_type")
  userId           String      @map("user_id") @db.Uuid
  centralSessionId String?     @map("central_session_id") @db.Uuid
  applicationId    String?     @map("application_id") @db.Uuid
  payload          Json
  status           EventStatus @default(PENDING)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime?   @map("published_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  centralSession SsoSession?     @relation(fields: [centralSessionId], references: [id], onDelete: SetNull)
  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  deliveries     EventDelivery[]

  @@index([status, createdAt])
  @@map("events")
}

model EventDelivery {
  id            String         @id @default(uuid()) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  status        DeliveryStatus @default(PENDING)
  attemptCount  Int            @default(0) @map("attempt_count")
  lastAttemptAt DateTime?      @map("last_attempt_at") @db.Timestamptz(6)
  nextRetryAt   DateTime?      @map("next_retry_at") @db.Timestamptz(6)
  processedAt   DateTime?      @map("processed_at") @db.Timestamptz(6)
  lastError     String?        @map("last_error")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([eventId, applicationId])
  @@index([status, nextRetryAt])
  @@map("event_deliveries")
}

model LocalSession {
  id               String        @id @default(uuid()) @db.Uuid
  applicationId    String        @map("application_id")
  sessionTokenHash String        @unique @map("session_token_hash")
  externalUserId   String        @map("external_user_id") @db.Uuid
  centralSessionId String        @map("central_session_id") @db.Uuid
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  lastActivityAt   DateTime?     @map("last_activity_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?       @map("revoke_reason")

  @@index([applicationId, externalUserId, status])
  @@index([applicationId, centralSessionId])
  @@map("local_sessions")
}

model ProfileCache {
  id             String   @id @default(uuid()) @db.Uuid
  applicationId  String   @map("application_id")
  externalUserId String   @map("external_user_id") @db.Uuid
  name           String
  email          String
  groups         Json?
  syncedAt       DateTime @map("synced_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([applicationId, externalUserId])
  @@map("profile_cache")
}

model ProcessedEvent {
  eventId       String   @map("event_id") @db.Uuid
  applicationId String   @map("application_id")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  result        String
  action        String?

  @@id([applicationId, eventId])
  @@map("processed_events")
}

model ActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id")
  eventType     String   @map("event_type")
  message       String
  requestId     String?  @map("request_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([applicationId, createdAt])
  @@map("activity_logs")
}
