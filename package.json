{
  "name": "centralized-identity-authorization-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:auth": "tsx auth-provider/server/src/index.ts",
    "dev:control-panel": "tsx auth-provider/control-panel/src/index.ts",
    "dev:worker": "tsx auth-provider/sync-worker/src/index.ts",
    "dev:app-a": "tsx applications/app-a/src/index.ts",
    "dev:app-b": "tsx applications/app-b/src/index.ts",
    "build": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "npm run db:generate && prisma db seed",
    "db:validate": "prisma validate",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/qrcode": "^1.5.6",
    "amqplib": "^2.0.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
